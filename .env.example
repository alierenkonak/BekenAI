# Local infrastructure
POSTGRES_DB=beken
POSTGRES_USER=beken
POSTGRES_PASSWORD=local-development-only
POSTGRES_PORT=5432
DATABASE_URL=postgresql://beken:local-development-only@localhost:5432/beken

QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Domain-aware retrieval indexes (generated artifacts stay out of Git)
RETRIEVAL_INDEX_ROOT=retrieval_data
RETRIEVAL_SCOPE_ROOT=retrieval-scopes
RETRIEVAL_MODEL_CATALOG=retrieval/config/models.json
RETRIEVAL_PROFILE_CATALOG=retrieval/config/domain_profiles.json
MODEL_INFERENCE_URL=http://127.0.0.1:8081
MODEL_INFERENCE_TOKEN=

# Hosted metadata and immutable raw-document storage
SUPABASE_URL=
SUPABASE_DB_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=legal-raw
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# Hosted LLM provider
LLM_PROVIDER=disabled
GEMINI_API_KEY=
GEMINI_PRIMARY_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
GEMINI_CLAIM_SUPPORT_MODEL=gemini-3.5-flash-lite
GEMINI_TARGET_INPUT_TOKENS=64000
GEMINI_MAX_INPUT_TOKENS=128000
GEMINI_MAX_OUTPUT_TOKENS=4096
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Authenticated private-file foundation
CASE_FILES_BUCKET=case-files
CASE_FILE_MAX_BYTES=52428800
USER_FILE_QUOTA_BYTES=104857600
CHAT_WORKER_POLL_SECONDS=2
CHAT_WORKER_STALE_MINUTES=10

# Application
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
