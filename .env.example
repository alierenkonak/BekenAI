# Local infrastructure
POSTGRES_DB=beken
POSTGRES_USER=beken
POSTGRES_PASSWORD=local-development-only
POSTGRES_PORT=5432
DATABASE_URL=postgresql://beken:local-development-only@localhost:5432/beken

QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Domain-aware retrieval indexes (generated artifacts stay out of Git)
RETRIEVAL_INDEX_ROOT=retrieval_data
RETRIEVAL_SCOPE_ROOT=retrieval-scopes
RETRIEVAL_MODEL_CATALOG=retrieval/config/models.json

# Hosted metadata and immutable raw-document storage
SUPABASE_URL=
SUPABASE_DB_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=legal-raw

# Future hosted LLM providers (not connected in Stage 2)
LLM_PROVIDER=disabled
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Application
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
